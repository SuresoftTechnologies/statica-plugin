{
  "description": "Runs the STATICA Agent Kit Stop hook that ships with STATIC. Does nothing when the Agent Kit is not installed.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "h=\"${ARACHNE_INSTALL_PATH%[\\\\/]}/agent_kit/plugins/hooks/stop-hook.cmd\"; [ -n \"$ARACHNE_INSTALL_PATH\" ] && [ -f \"$h\" ] || exit 0; \"$h\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
