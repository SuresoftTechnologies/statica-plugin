{
  "_comment": "Known-path data table for Windows IDE/toolchain detection. Each entry maps an IDE/environment to the executables it ships and the standard install path patterns. Version/revision parts of paths are globs (*), so vendor version bumps keep matching. Executable names are SEEDS: the detector globs the matched bin folder for anything that looks like a compiler/linker/archiver and verifies it, rather than trusting the name. Path separators are normalized, so forward slashes here are fine on Windows.",
  "environments": [
    {
      "id": "aurix-tasking-cctc",
      "name": "AURIX - TASKING CCTC",
      "family": "tasking",
      "compiler_seeds": ["cctc.exe"],
      "cpp_compiler_seeds": ["cctc.exe"],
      "linker_seeds": ["ltc.exe"],
      "archiver_seeds": ["artc.exe"],
      "path_patterns": [
        "C:/Infineon/AURIX-Studio-*/tools/Compilers/Tasking_*/ctc/bin"
      ]
    },
    {
      "id": "aurix-tricore-gcc",
      "name": "AURIX - TriCore GCC",
      "family": "gcc",
      "compiler_seeds": ["tricore-*-gcc.exe"],
      "cpp_compiler_seeds": ["tricore-*-g++.exe", "tricore-*-c++.exe"],
      "linker_seeds": ["tricore-*-ld.exe"],
      "archiver_seeds": ["tricore-*-ar.exe"],
      "ranlib_seeds": ["tricore-*-ranlib.exe"],
      "path_patterns": [
        "C:/Infineon/AURIX-Studio-*/tools/Compilers/tricore-gcc*/bin"
      ]
    },
    {
      "id": "mingw-gcc",
      "name": "CMake/Makefile - MinGW GCC",
      "family": "gcc",
      "compiler_seeds": ["gcc.exe"],
      "cpp_compiler_seeds": ["g++.exe"],
      "linker_seeds": ["ld.exe"],
      "archiver_seeds": ["ar.exe"],
      "ranlib_seeds": ["ranlib.exe"],
      "path_patterns": [
        "C:/MinGW/bin",
        "C:/msys64/mingw64/bin",
        "C:/msys64/mingw32/bin"
      ]
    },
    {
      "id": "llvm-clang",
