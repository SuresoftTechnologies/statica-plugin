      "linker_seeds": ["cl2000.exe", "cl430.exe", "cl6x.exe", "armcl.exe"],
      "archiver_seeds": ["ar2000.exe", "ar430.exe", "ar6x.exe", "armar.exe"],
      "path_patterns": [
        "C:/ti/ccs*/ccs/tools/compiler/ti-cgt-*/bin"
