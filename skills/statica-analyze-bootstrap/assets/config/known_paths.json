      "linker_seeds": ["lld.exe", "ld.lld.exe", "lld-link.exe"],
      "archiver_seeds": ["llvm-ar.exe"],
      "ranlib_seeds": ["llvm-ranlib.exe"],
      "path_patterns": [
        "C:/Program Files/LLVM/bin",
        "C:/Program Files (x86)/LLVM/bin"
